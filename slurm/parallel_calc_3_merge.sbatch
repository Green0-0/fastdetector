#!/bin/bash
#SBATCH --job-name=calc_stats_merge
#SBATCH --output=calc_stats_merge_%j.out
#SBATCH --error=calc_stats_merge_%j.err
#SBATCH --time=6-00:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G

source .venv/bin/activate
export PYTHONUNBUFFERED=1

echo "Merging split datasets..."
python -c "
import os
from datasets import load_from_disk, concatenate_datasets
shards = []
num_shards = 25
CACHE_DIR = '/usr/project/xtmp/ccprocessing_cache/'
for i in range(num_shards):
    safe_name = f'G-reen_cc-2021-rewritten-split-{i}-stat'
    local_path = os.path.join(CACHE_DIR, safe_name)
    print(f'Loading shard from {local_path}...')
    shards.append(load_from_disk(local_path))

print('Concatenating shards...')
merged_ds = concatenate_datasets(shards)
merged_name = 'G-reen/cc-2021-rewritten-stat'
print(f'Pushing merged dataset to {merged_name}...')
merged_ds.push_to_hub(merged_name)
print('Merge complete.')
"

echo "Calculating quantiles on merged dataset..."
python scripts/auxilary/metrics/calc_quantiles.py \
    --source-dataset G-reen/cc-2021-rewritten-stat \
    --target-dataset G-reen/cc-2021-rewritten-stat \
    --columns pairwise_cosdist_original_final_response levenshtein_original_final_response jaccard_1_original_final_response jaccard_2_original_final_response pairwise_cross_encoder_original_final_response pairwise_softngram_original_final_response pairwise_bertscore_f1_original_final_response pairwise_moverscore_original_final_response

echo "Calculating minimax norms on merged dataset..."
python scripts/auxilary/metrics/calc_minimax_norms.py \
    --source-dataset G-reen/cc-2021-rewritten-stat \
    --target-dataset G-reen/cc-2021-rewritten-stat \
    --columns pairwise_cosdist_original_final_response levenshtein_original_final_response jaccard_1_original_final_response jaccard_2_original_final_response pairwise_cross_encoder_original_final_response pairwise_softngram_original_final_response pairwise_bertscore_f1_original_final_response pairwise_moverscore_original_final_response

echo "Building readme on merged dataset..."
python scripts/auxilary/metrics/build_readme.py \
    --source-dataset G-reen/cc-2021-rewritten-stat \
    --target-dataset G-reen/cc-2021-rewritten-stat \
    --text-columns-analyze original final_response \
    --summary-stat-columns original_tokens_llama_perplexity final_response_tokens_llama_perplexity original_tokens_llama_base_perplexity final_response_tokens_llama_base_perplexity original_tokens_llama_entropy final_response_tokens_llama_entropy original_tokens_llama_base_entropy final_response_tokens_llama_base_entropy original_tokens_llama_fastdetectgpt final_response_tokens_llama_fastdetectgpt original_tokens_llama_base_fastdetectgpt final_response_tokens_llama_base_fastdetectgpt original_tokens_llama_topp_outlier final_response_tokens_llama_topp_outlier original_tokens_llama_base_topp_outlier final_response_tokens_llama_base_topp_outlier original_tokens_llama_topk_outlier final_response_tokens_llama_topk_outlier original_tokens_llama_base_topk_outlier final_response_tokens_llama_base_topk_outlier original_tokens_llama_binoculars final_response_tokens_llama_binoculars pairwise_cosdist_original_final_response pairwise_cross_encoder_original_final_response pairwise_softngram_original_final_response pairwise_bertscore_f1_original_final_response pairwise_moverscore_original_final_response \
    --pairwise-correlations levenshtein_original_final_response_quantile pairwise_cross_encoder_original_final_response_quantile jaccard_1_original_final_response_quantile pairwise_cosdist_original_final_response_quantile pairwise_softngram_original_final_response_quantile pairwise_bertscore_f1_original_final_response_quantile pairwise_moverscore_original_final_response_quantile \
    --histogram-columns original_tokens_llama_perplexity/final_response_tokens_llama_perplexity/original_tokens_llama_base_perplexity/final_response_tokens_llama_base_perplexity original_tokens_llama_entropy/final_response_tokens_llama_entropy/original_tokens_llama_base_entropy/final_response_tokens_llama_base_entropy original_tokens_llama_fastdetectgpt/final_response_tokens_llama_fastdetectgpt/original_tokens_llama_base_fastdetectgpt/final_response_tokens_llama_base_fastdetectgpt original_tokens_llama_topp_outlier/final_response_tokens_llama_topp_outlier/original_tokens_llama_base_topp_outlier/final_response_tokens_llama_base_topp_outlier original_tokens_llama_topk_outlier/final_response_tokens_llama_topk_outlier/original_tokens_llama_base_topk_outlier/final_response_tokens_llama_base_topk_outlier original_tokens_llama_binoculars/final_response_tokens_llama_binoculars pairwise_cosdist_original_final_response pairwise_cross_encoder_original_final_response levenshtein_original_final_response jaccard_1_original_final_response/jaccard_2_original_final_response pairwise_softngram_original_final_response pairwise_bertscore_f1_original_final_response pairwise_moverscore_original_final_response \
    --scatterplot-columns pairwise_softngram_original_final_response/original_tokens_llama_binoculars/final_response_tokens_llama_binoculars pairwise_softngram_original_final_response/original_tokens_llama_fastdetectgpt/final_response_tokens_llama_fastdetectgpt pairwise_cosdist_original_final_response/original_tokens_llama_binoculars/final_response_tokens_llama_binoculars pairwise_cosdist_original_final_response/original_tokens_llama_fastdetectgpt/final_response_tokens_llama_fastdetectgpt pairwise_softngram_original_final_response/original_tokens_llama_perplexity/final_response_tokens_llama_perplexity pairwise_softngram_original_final_response/original_tokens_llama_entropy/final_response_tokens_llama_entropy pairwise_softngram_original_final_response/original_tokens_llama_topp_outlier/final_response_tokens_llama_topp_outlier pairwise_softngram_original_final_response/original_tokens_llama_topk_outlier/final_response_tokens_llama_topk_outlier pairwise_cosdist_original_final_response/original_tokens_llama_perplexity/final_response_tokens_llama_perplexity pairwise_cosdist_original_final_response/original_tokens_llama_entropy/final_response_tokens_llama_entropy pairwise_cosdist_original_final_response/original_tokens_llama_topp_outlier/final_response_tokens_llama_topp_outlier pairwise_cosdist_original_final_response/original_tokens_llama_topk_outlier/final_response_tokens_llama_topk_outlier pairwise_cosdist_original_final_response/pairwise_softngram_original_final_response \
    --classifier-columns original_tokens_llama_fastdetectgpt:false/final_response_tokens_llama_fastdetectgpt:true original_tokens_llama_base_fastdetectgpt:false/final_response_tokens_llama_base_fastdetectgpt:true original_tokens_llama_binoculars:true/final_response_tokens_llama_binoculars:false

echo "All complete!"
